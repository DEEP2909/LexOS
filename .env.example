# ============================================================
# EvidentIS Environment Configuration
# Copy to .env and fill in values
# ============================================================

# ---- Node.js API ----
NODE_ENV=development
PORT=4000

# Auth - RS256 JWT Keys (generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
# 32-byte hex key for AES-256-GCM (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
APP_ENCRYPTION_KEY=

# Database
DATABASE_URL=postgresql://evidentis:evidentis_dev_password@localhost:5432/evidentis
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_SSL=false
DB_SSL_CA=
# Set to true to seed demo data on startup (NEVER in production!)
SEED_DEMO_DATA=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB_QUEUE=0
REDIS_DB_CACHE=3

# Storage
STORAGE_BACKEND=local                        # local | s3
LOCAL_STORAGE_PATH=./storage
S3_REGION=us-east-1
S3_BUCKET=evidentis-documents
S3_ENDPOINT=                                 # MinIO endpoint or leave blank for AWS
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI Service
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_TIMEOUT_MS=60000

# Malware Scanner - NEVER set to 'none' in production!
MALWARE_SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Email
EMAIL_DELIVERY_MODE=log                      # log | smtp
MAIL_FROM=noreply@evidentis.law
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Paddle Billing
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=pri_starter
PADDLE_PRICE_GROWTH=pri_growth
PADDLE_PRICE_PROFESSIONAL=pri_professional

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=evidentis-api

# OpenAI (premium tier fallback only — not required for open-source tier)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# ---- Python AI Service ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_EXTRACT=mistral:7b-instruct-q4_K_M
OLLAMA_MODEL_RESEARCH=mistral:7b-instruct-q4_K_M
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
OCR_ENGINES=tesseract,easyocr
GPU_ENABLED=false
MODEL_CACHE_DIR=./models
CLAUSE_EXTRACTION_THRESHOLD=0.70
RESEARCH_CACHE_TTL_SECONDS=3600

# ---- Next.js Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
